{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudeBridge",
  "version": "0.2.4",
  "identifier": "com.claudebridge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClaudeBridge — 全账号会话",
        "width": 1200,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/GitHub-steam/claude-bridge/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGM0Y0RUVBOTIwMUVDRDkKUldUWjdBR1M2azQvTHlIZDBhUmloNVBhQUMxZnZoUVVjRXVoVERvbmJqaG00NmxyTG5OWGQ1SjUK"
    }
  }
}
